  -dualLeNumerator (.outsideLower x)+dualLeNumerator (.outsideUpper x)+dualLeNumerator .mass-
    (if x.2.1 = .S then dualLeNumerator .rootMoment else 0)-
    (if x.2.1 = .T then dualLeNumerator .missingMoment else 0)
def grid : Fin 153 → ℤ := fun i => gridNumerator i.val
def representative (t : CenterType) : CenterClass 152 := (⟨0,by decide⟩,t)

end RobustMatching.R7ReductionCertificate.Concrete
